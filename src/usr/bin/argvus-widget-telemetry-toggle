#!/usr/bin/env sh

# shellcheck disable=SC1090
ARGVUS_BOOTSTRAP="${ARGVUS_BOOTSTRAP:-${ARGVUS_SYSTEM_CONFIG:-/usr/share/argvus}/session/sh/bootstrap.sh}"
. "$ARGVUS_BOOTSTRAP"

ARGVUS_I18N_HELPER="$ARGVUS_SYSTEM_CONFIG/lib/i18n.sh"
. "$ARGVUS_I18N_HELPER"

STATE_FILE="$(paths_cache waybar/widget-telemetry-state)"
LEGACY_DESKTOP_STATE_FILE="$(paths_cache waybar/desktop-telemetry-state)"
LEGACY_STATE_FILE="$(paths_cache waybar/sysinfo-state)"

ensure_state_dir() {
    mkdir -p "$(dirname "$STATE_FILE")"
}

cmd_on() {
    ensure_state_dir
    echo enabled > "$STATE_FILE"
    if command -v systemctl >/dev/null 2>&1; then
        systemctl --user restart argvus-widget-telemetry.service >/dev/null 2>&1 || true
    fi
    if [ "${ARGVUS_MACHINE_OUTPUT:-0}" = 1 ]; then
        printf "enabled\n"
    else
        argvus_tr widget-telemetry state.enabled
    fi
}

cmd_off() {
    ensure_state_dir
    echo disabled > "$STATE_FILE"
    if command -v systemctl >/dev/null 2>&1; then
        systemctl --user stop argvus-widget-telemetry.service >/dev/null 2>&1 || true
    fi
    if [ "${ARGVUS_MACHINE_OUTPUT:-0}" = 1 ]; then
        printf "disabled\n"
    else
        argvus_tr widget-telemetry state.disabled
    fi
}

cmd_status_value() {
    if [ -f "$STATE_FILE" ]; then
        cat "$STATE_FILE"
    elif [ -f "$LEGACY_DESKTOP_STATE_FILE" ]; then
        cat "$LEGACY_DESKTOP_STATE_FILE"
    elif [ -f "$LEGACY_STATE_FILE" ]; then
        cat "$LEGACY_STATE_FILE"
    elif command -v systemctl >/dev/null 2>&1 && systemctl --user is-active --quiet argvus-widget-telemetry.service 2>/dev/null; then
        printf "enabled\n"
    else
        printf "disabled\n"
    fi
}

cmd_status() {
    case "$(cmd_status_value)" in
      enabled)
        if [ "${ARGVUS_MACHINE_OUTPUT:-0}" = 1 ]; then
            printf "enabled\n"
        else
            argvus_tr widget-telemetry state.enabled
        fi
        ;;
      *)
        if [ "${ARGVUS_MACHINE_OUTPUT:-0}" = 1 ]; then
            printf "disabled\n"
        else
            argvus_tr widget-telemetry state.disabled
        fi
        ;;
    esac
}

cmd_toggle() {
    case "$(cmd_status_value)" in
      enabled) cmd_off ;;
      *)       cmd_on ;;
    esac
}

case "$1" in
  on) cmd_on ;;
  off) cmd_off ;;
  status) cmd_status ;;
  toggle) cmd_toggle ;;
  *)
    argvus_tr widget-telemetry cli.usage command="$0" options="{on|off|toggle|status}"
    exit 1
    ;;
esac
