#!/usr/bin/env sh

# shellcheck disable=SC1090
ARGVUS_BOOTSTRAP="${ARGVUS_BOOTSTRAP:-${ARGVUS_SYSTEM_CONFIG:-/usr/share/argvus}/session/sh/bootstrap.sh}"
. "$ARGVUS_BOOTSTRAP"

ARGVUS_I18N_HELPER="$ARGVUS_SYSTEM_CONFIG/lib/i18n.sh"
. "$ARGVUS_I18N_HELPER"

STATE_FILE="$(paths_cache waybar/widget-telemetry-state)"
LEGACY_DESKTOP_STATE_FILE="$(paths_cache waybar/desktop-telemetry-state)"
LEGACY_STATE_FILE="$(paths_cache waybar/sysinfo-state)"
BLOCKS_FILE="${ARGVUS_STATE_HOME}/widget-telemetry-blocks"
BLOCK_NAMES="system cpu_gpu memory storage processes network dev_dashboard keys"

ensure_state_dir() {
    mkdir -p "$(dirname "$STATE_FILE")"
}

canonical_master_state() {
    command -v argvus >/dev/null 2>&1 || return 1
    _value="$(argvus config get /effects/widget_telemetry_enabled --effective --raw 2>/dev/null || true)"
    case "$_value" in
        true|enabled) printf '%s\n' enabled ;;
        false|disabled) printf '%s\n' disabled ;;
        *) return 1 ;;
    esac
}

set_canonical_master() {
    command -v argvus >/dev/null 2>&1 || return 0
    argvus config set /effects/widget_telemetry_enabled "$1" >/dev/null 2>&1 || return 1
    if [ "${ARGVUS_CONFIG_SERVICE:-0}" != 1 ] && [ "${ARGVUS_PROJECTING:-0}" != 1 ]; then
        systemctl --user reload argvus-config.service >/dev/null 2>&1 || return 1
    fi
}

# Return the stored state for one named telemetry block. Missing preferences
# deliberately mean enabled so upgrades preserve the complete legacy widget.
block_state() {
    _block="$1"
    if [ -r "$BLOCKS_FILE" ]; then
        _value="$(sed -n "s/^${_block}=//p" "$BLOCKS_FILE" | sed -n '1p')"
        case "$_value" in
            enabled|disabled) printf '%s\n' "$_value"; return 0 ;;
        esac
    fi
    printf '%s\n' enabled
}

# Prints the configured display order (space-separated), reconciled against
# BLOCK_NAMES: keeps the persisted order, drops names the package no longer
# defines, and appends any new block (from a package upgrade) that is not in
# it yet, at the end.
current_order() {
    _stored=""
    if [ -r "$BLOCKS_FILE" ]; then
        _stored="$(sed -n 's/^__order__=//p' "$BLOCKS_FILE" | sed -n '1p' | tr ',' ' ')"
    fi
    _reconciled=""
    for _block in $_stored; do
        case " $BLOCK_NAMES " in
            *" $_block "*)
                case " $_reconciled " in
                    *" $_block "*) ;;
                    *) _reconciled="$_reconciled $_block" ;;
                esac
                ;;
        esac
    done
    for _block in $BLOCK_NAMES; do
        case " $_reconciled " in
            *" $_block "*) ;;
            *) _reconciled="$_reconciled $_block" ;;
        esac
    done
    printf '%s\n' "${_reconciled# }"
}

# Validates that $1 is a comma-separated permutation of BLOCK_NAMES, so a
# malformed or stale order argument never corrupts the blocks file.
valid_order() {
    _seen=""
    _count=0
    for _block in $(printf '%s' "$1" | tr ',' ' '); do
        case " $BLOCK_NAMES " in
            *" $_block "*) ;;
            *) return 1 ;;
        esac
        case " $_seen " in
            *" $_block "*) return 1 ;;
        esac
        _seen="$_seen $_block"
        _count=$((_count + 1))
    done
    _expected=0
    for _block in $BLOCK_NAMES; do
        _expected=$((_expected + 1))
    done
    [ "$_count" -eq "$_expected" ]
}

write_blocks_file() {
    _changed_block="$1"
    _changed_value="$2"
    _order="$(current_order | tr ' ' ',')"
    mkdir -p "${BLOCKS_FILE%/*}"
    _temporary_file="$(mktemp "${BLOCKS_FILE}.tmp.XXXXXX")"
    {
        printf '__order__=%s\n' "$_order"
        for _block in $BLOCK_NAMES; do
            if [ "$_block" = "$_changed_block" ]; then
                printf '%s=%s\n' "$_block" "$_changed_value"
            else
                printf '%s=%s\n' "$_block" "$(block_state "$_block")"
            fi
        done
    } > "$_temporary_file"
    mv "$_temporary_file" "$BLOCKS_FILE"
}

# Enable or comment the paired Waybar declarations for a persisted block.
# Markers stay visible so repeated application remains idempotent.
apply_block() {
    _config="$1"
    _block="$2"
    _marker="ARGVUS_TELEMETRY_$(printf '%s' "$_block" | tr '[:lower:]' '[:upper:]')"
    case "$(block_state "$_block")" in
        enabled)
            sed -i "/${_marker}_BEGIN/,/${_marker}_END/{
                /${_marker}_BEGIN/b
                /${_marker}_END/b
                s|^//||
            }" "$_config"
            ;;
        disabled)
            sed -i "/${_marker}_BEGIN/,/${_marker}_END/{
                /${_marker}_BEGIN/b
                /${_marker}_END/b
                /^[[:space:]]*\/\//b
                s|^|//|
            }" "$_config"
            ;;
    esac
}

# Keep the top-level module definitions valid when only an earlier block is
# enabled. JSONC comments do not make a trailing object comma valid.
normalize_module_properties() {
    _config="$1"
    _temporary_file="$(mktemp "${_config}.tmp.XXXXXX")"
    awk '
        { lines[NR] = $0 }
        /^    },?[[:space:]]*$/ { closings[++closing_count] = NR; last = NR }
        END {
            for (closing_no = 1; closing_no <= closing_count; closing_no++) {
                line_no = closings[closing_no]
                sub(/,[[:space:]]*$/, "", lines[line_no])
                if (line_no != last) lines[line_no] = lines[line_no] ","
            }
            for (line_no = 1; line_no <= NR; line_no++) print lines[line_no]
        }
    ' "$_config" > "$_temporary_file"
    mv "$_temporary_file" "$_config"
}

# Keep the JSONC array valid when its final enabled block changes. Waybar's
# parser accepts comments but does not accept a trailing comma in this array.
normalize_modules_left() {
    _config="$1"
    _temporary_file="$(mktemp "${_config}.tmp.XXXXXX")"
    awk '
        /"modules-left"[[:space:]]*:/ { inside = 1; print; next }
        inside && /^[[:space:]]*\],/ {
            for (line_no = 1; line_no <= count; line_no++) {
                if (lines[line_no] ~ /^[[:space:]]*"custom\//) {
                    sub(/,[[:space:]]*$/, "", lines[line_no])
                    if (line_no != last) lines[line_no] = lines[line_no] ","
                }
                print lines[line_no]
            }
            print
            inside = 0
            count = 0
            last = 0
            next
        }
        inside {
            lines[++count] = $0
            if ($0 ~ /^[[:space:]]*"custom\//) last = count
            next
        }
        { print }
    ' "$_config" > "$_temporary_file"
    mv "$_temporary_file" "$_config"
}

# Moves each block's already-applied modules-left chunk to match the
# persisted display order. Comment state set by apply_block travels with its
# chunk, since the BEGIN/END markers used to extract it move together.
reorder_modules_left() {
    _config="$1"
    _chunks_dir="$(mktemp -d)"
    for _block in $BLOCK_NAMES; do
        _marker="ARGVUS_TELEMETRY_$(printf '%s' "$_block" | tr '[:lower:]' '[:upper:]')"
        sed -n "/${_marker}_BEGIN/,/${_marker}_END/{p; /${_marker}_END/q}" "$_config" \
            > "${_chunks_dir}/${_block}"
    done
    _temporary_file="$(mktemp "${_config}.tmp.XXXXXX")"
    awk -v chunks_dir="$_chunks_dir" -v order="$(current_order)" '
        BEGIN { split(order, blocks, " ") }
        /"modules-left"[[:space:]]*:/ {
            print
            for (i = 1; i in blocks; i++) {
                chunk = chunks_dir "/" blocks[i]
                while ((getline line < chunk) > 0) print line
                close(chunk)
            }
            inside = 1
            next
        }
        inside && /^[[:space:]]*\],/ { inside = 0; print; next }
        inside { next }
        { print }
    ' "$_config" > "$_temporary_file"
    mv "$_temporary_file" "$_config"
    rm -rf "$_chunks_dir"
}

apply_blocks() {
    _config="$(paths_config widget-telemetry/config/argvus-widget-telemetry.jsonc)"
    [ -f "$_config" ] || {
        printf '%s\n' "missing widget telemetry configuration: $_config" >&2
        return 1
    }
    for _block in $BLOCK_NAMES; do
        apply_block "$_config" "$_block"
    done
    reorder_modules_left "$_config"
    normalize_modules_left "$_config"
    normalize_module_properties "$_config"
}

any_block_enabled() {
    for _block in $BLOCK_NAMES; do
        [ "$(block_state "$_block")" = enabled ] && return 0
    done
    return 1
}

stop_widget() {
    if command -v systemctl >/dev/null 2>&1; then
        systemctl --user stop argvus-widget-telemetry.service >/dev/null 2>&1 || true
    fi
}

master_state_value() {
    if canonical_master_state; then
        return 0
    elif [ -f "$STATE_FILE" ]; then
        cat "$STATE_FILE"
    elif [ -f "$LEGACY_DESKTOP_STATE_FILE" ]; then
        cat "$LEGACY_DESKTOP_STATE_FILE"
    elif [ -f "$LEGACY_STATE_FILE" ]; then
        cat "$LEGACY_STATE_FILE"
    elif command -v systemctl >/dev/null 2>&1 && systemctl --user is-active --quiet argvus-widget-telemetry.service 2>/dev/null; then
        printf "enabled\n"
    else
        printf "disabled\n"
    fi
}

sync_widget_service() {
    if [ "$(master_state_value)" = enabled ] && any_block_enabled; then
        if command -v systemctl >/dev/null 2>&1; then
            systemctl --user restart argvus-widget-telemetry.service >/dev/null 2>&1 || true
        fi
    else
        stop_widget
    fi
}

restart_widget() {
    sync_widget_service
}

effective_state_value() {
    if [ "$(master_state_value)" = enabled ] && any_block_enabled; then
        printf "enabled\n"
    else
        printf "disabled\n"
    fi
}

cmd_on() {
    ensure_state_dir
    set_canonical_master true || true
    echo enabled > "$STATE_FILE"
    reset_scroll
    restart_widget
    if [ "$(effective_state_value)" = enabled ]; then
        _state=enabled
    else
        _state=disabled
    fi
    if [ "${ARGVUS_MACHINE_OUTPUT:-0}" = 1 ]; then
        printf '%s\n' "$_state"
    elif [ "$_state" = enabled ]; then
        argvus_tr widget-telemetry state.enabled
    else
        argvus_tr widget-telemetry state.disabled
    fi
}

cmd_off() {
    ensure_state_dir
    set_canonical_master false || true
    echo disabled > "$STATE_FILE"
    stop_widget
    if [ "${ARGVUS_MACHINE_OUTPUT:-0}" = 1 ]; then
        printf "disabled\n"
    else
        argvus_tr widget-telemetry state.disabled
    fi
}

cmd_status_value() {
    effective_state_value
}

cmd_status() {
    case "$(cmd_status_value)" in
      enabled)
        if [ "${ARGVUS_MACHINE_OUTPUT:-0}" = 1 ]; then
            printf "enabled\n"
        else
            argvus_tr widget-telemetry state.enabled
        fi
        ;;
      *)
        if [ "${ARGVUS_MACHINE_OUTPUT:-0}" = 1 ]; then
            printf "disabled\n"
        else
            argvus_tr widget-telemetry state.disabled
        fi
        ;;
    esac
}

cmd_toggle() {
    case "$(cmd_status_value)" in
      enabled) cmd_off ;;
      *)       cmd_on ;;
    esac
}

cmd_blocks_status() {
    printf '__order__=%s\n' "$(current_order | tr ' ' ',')"
    for _block in $BLOCK_NAMES; do
        printf '%s=%s\n' "$_block" "$(block_state "$_block")"
    done
}

cmd_blocks_set() {
    _block="${1:-}"
    _value="${2:-}"
    case " $_block " in
        *" system "*|*" cpu_gpu "*|*" memory "*|*" storage "*|*" processes "*|*" network "*|*" keys "*|*" dev_dashboard ") ;;
        *) printf '%s\n' "invalid telemetry block: ${_block:-empty}" >&2; return 2 ;;
    esac
    case "$_value" in
        enabled|disabled) ;;
        *) printf '%s\n' "invalid telemetry block state: ${_value:-empty}" >&2; return 2 ;;
    esac
    write_blocks_file "$_block" "$_value"
    reset_scroll
    apply_blocks
    restart_widget
}

cmd_apply_state() {
    _master="${1:-}"
    case "$_master" in enabled|disabled) ;; *) return 2 ;; esac
    shift
    [ "$#" -eq 9 ] || return 2
    _system="$1"; _cpu_gpu="$2"; _memory="$3"; _storage="$4"
    _processes="$5"; _network="$6"; _keys="$7"; _dev_dashboard="$8"; _order="$9"
    for _value in "$1" "$2" "$3" "$4" "$5" "$6" "$7" "$8"; do
        case "$_value" in enabled|disabled) ;; *) return 2 ;; esac
    done
    valid_order "$_order" || return 2
    ensure_state_dir
    mkdir -p "${BLOCKS_FILE%/*}"
    set_canonical_master "$([ "$_master" = enabled ] && printf true || printf false)" || true
    printf '%s\n' "$_master" > "$STATE_FILE"
    _temporary_file="$(mktemp "${BLOCKS_FILE}.tmp.XXXXXX")"
    {
        printf '__order__=%s\n' "$_order"
        printf '%s=%s\n' system "$_system"
        printf '%s=%s\n' cpu_gpu "$_cpu_gpu"
        printf '%s=%s\n' memory "$_memory"
        printf '%s=%s\n' storage "$_storage"
        printf '%s=%s\n' processes "$_processes"
        printf '%s=%s\n' network "$_network"
        printf '%s=%s\n' keys "$_keys"
        printf '%s=%s\n' dev_dashboard "$_dev_dashboard"
    } > "$_temporary_file"
    mv "$_temporary_file" "$BLOCKS_FILE"
    reset_scroll
    apply_blocks
    sync_widget_service
}

cmd_blocks() {
    case "${1:-status}" in
        status) cmd_blocks_status ;;
        apply) apply_blocks ;;
        set) cmd_blocks_set "${2:-}" "${3:-}" ;;
        *)
            printf '%s\n' "usage: $0 blocks {status|apply|set <block> <enabled|disabled>}" >&2
            return 2
            ;;
    esac
}

# -- Scroll window --------------------------------------------------------------
# When the enabled blocks are taller than the monitor, the mouse wheel slides a
# window over them instead of clipping the bottom. Heights are estimates in
# pixels calibrated to the stylesheet, so the layout does not depend on the
# rendered output of every block.

SCROLL_STATE_FILE="$(paths_cache waybar/widget-telemetry-scroll)"
# Realtime signal declared as "signal" on every widget module in the jsonc.
SCROLL_SIGNAL=13
HEADER_PX=28
ROW_PX=19
BLOCK_GAP_PX=8

# Text lines a block renders, excluding its header.
block_lines() {
    case "$1" in
        system) printf '%s\n' 9 ;;
        processes) printf '%s\n' 6 ;;
        network) printf '%s\n' 2 ;;
        keys) printf '%s\n' 1 ;;
        *) printf '%s\n' 3 ;;
    esac
}

block_px() {
    _lines="$(block_lines "$1")"
    printf '%s\n' $((HEADER_PX + _lines * ROW_PX + BLOCK_GAP_PX))
}

# Usable height in pixels of the focused monitor. Prints nothing when Hyprland
# or jq cannot answer, in which case every block is shown.
monitor_budget_px() {
    command -v hyprctl >/dev/null 2>&1 || return 0
    command -v jq >/dev/null 2>&1 || return 0
    hyprctl monitors -j 2>/dev/null \
        | jq -r '[.[] | select(.focused)][0] | select(. != null)
            | ((.height / .scale) - .reserved[0] - .reserved[2]) | floor' 2>/dev/null
}

scroll_offset() {
    _value="$(sed -n '1p' "$SCROLL_STATE_FILE" 2>/dev/null || true)"
    case "$_value" in
        ""|*[!0-9]*) printf '%s\n' 0 ;;
        *) printf '%s\n' "$_value" ;;
    esac
}

write_scroll_offset() {
    mkdir -p "${SCROLL_STATE_FILE%/*}"
    printf '%s\n' "$1" > "$SCROLL_STATE_FILE"
}

reset_scroll() {
    write_scroll_offset 0
}

# Computes the visible window into LAYOUT_* variables. The offset is clamped so
# the list never scrolls past its last block, and everything is shown when the
# enabled blocks fit the budget.
scroll_layout() {
    _items=""
    _total=0
    _count=0
    for _block in $(current_order); do
        [ "$(block_state "$_block")" = enabled ] || continue
        _px="$(block_px "$_block")"
        _items="$_items $_block:$_px"
        _total=$((_total + _px))
        _count=$((_count + 1))
    done

    _budget="$(monitor_budget_px)"
    case "$_budget" in
        ""|*[!0-9]*) _budget="$_total" ;;
    esac

    # Largest offset from which the rest of the list still fits the budget.
    _max=0
    _prefix=0
    for _item in $_items; do
        [ $((_total - _prefix)) -le "$_budget" ] && break
        _prefix=$((_prefix + ${_item##*:}))
        _max=$((_max + 1))
    done
    if [ "$_count" -eq 0 ]; then
        _max=0
    elif [ "$_max" -ge "$_count" ]; then
        _max=$((_count - 1))
    fi

    _offset="$(scroll_offset)"
    [ "$_offset" -gt "$_max" ] && _offset="$_max"

    LAYOUT_VISIBLE=""
    LAYOUT_FIRST=""
    LAYOUT_LAST=""
    _used=0
    _index=0
    _last_index=-1
    for _item in $_items; do
        _block="${_item%%:*}"
        _px="${_item##*:}"
        if [ "$_index" -ge "$_offset" ]; then
            if [ -n "$LAYOUT_VISIBLE" ] && [ $((_used + _px)) -gt "$_budget" ]; then
                break
            fi
            if [ -z "$LAYOUT_FIRST" ]; then
                LAYOUT_FIRST="$_block"
            fi
            LAYOUT_VISIBLE="${LAYOUT_VISIBLE:+$LAYOUT_VISIBLE }$_block"
            LAYOUT_LAST="$_block"
            _used=$((_used + _px))
            _last_index="$_index"
        fi
        _index=$((_index + 1))
    done

    LAYOUT_OFFSET="$_offset"
    LAYOUT_MAX="$_max"
    LAYOUT_ABOVE=0
    [ "$_offset" -gt 0 ] && LAYOUT_ABOVE=1
    LAYOUT_BELOW=0
    [ "$_last_index" -lt $((_count - 1)) ] && LAYOUT_BELOW=1
}

refresh_widget() {
    command -v systemctl >/dev/null 2>&1 || return 0
    systemctl --user kill --signal="RTMIN+$SCROLL_SIGNAL" argvus-widget-telemetry.service >/dev/null 2>&1 || true
}

cmd_visible() {
    scroll_layout
    printf '%s\n' "$LAYOUT_VISIBLE"
}

cmd_layout() {
    scroll_layout
    printf 'visible=%s\n' "$LAYOUT_VISIBLE"
    printf 'first=%s\n' "$LAYOUT_FIRST"
    printf 'last=%s\n' "$LAYOUT_LAST"
    printf 'offset=%s\n' "$LAYOUT_OFFSET"
    printf 'max=%s\n' "$LAYOUT_MAX"
    printf 'above=%s\n' "$LAYOUT_ABOVE"
    printf 'below=%s\n' "$LAYOUT_BELOW"
}

cmd_scroll() {
    scroll_layout
    case "${1:-}" in
        up) _target=$((LAYOUT_OFFSET - 1)) ;;
        down) _target=$((LAYOUT_OFFSET + 1)) ;;
        *)
            printf '%s\n' "usage: $0 scroll {up|down}" >&2
            return 2
            ;;
    esac
    [ "$_target" -lt 0 ] && _target=0
    [ "$_target" -gt "$LAYOUT_MAX" ] && _target="$LAYOUT_MAX"
    write_scroll_offset "$_target"
    refresh_widget
}

case "$1" in
  apply-state) shift; cmd_apply_state "$@" ;;
  scroll) shift; cmd_scroll "$@" ;;
  visible) cmd_visible ;;
  layout) cmd_layout ;;
  on) cmd_on ;;
  off) cmd_off ;;
  status) cmd_status ;;
  toggle) cmd_toggle ;;
  blocks) shift; cmd_blocks "$@" ;;
  *)
    argvus_tr widget-telemetry cli.usage command="$0" options="{on|off|toggle|status|blocks|scroll}"
    exit 1
    ;;
esac
